# Dependencies
node_modules/

# Rust build artifacts
target/

# npm pack / publish output
*.tgz

# Evaluation results are collected per-run and are not part of the package.
evals/results/*

# Artifacts the skill writes into a consuming workspace.
# Track audit reports and structured findings; ignore transient run state.
.diligent/*
!.diligent/*/
!.diligent/*/*.json
!.diligent/*/*.jsonl
!.diligent/*/*.md
!.diligent/*/runs/

# Session handoffs and working specs. Local coordination state, not part of the skill.
tasks/

# Working screenshots. Anything tracked here ships to every user.
*.png
*.jpeg
*.jpg

# OS noise
.DS_Store
Thumbs.db

# Logs and editor scratch
*.log
*.swp
