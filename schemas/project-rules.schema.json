{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/project-rules.schema.json",
  "title": "Project rules",
  "description": "PROJECT-RULES.json: repair rules and usage guardrails (blueprint 32).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "repair_rule",
              "usage_guardrail"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "validated",
              "active",
              "superseded",
              "retired"
            ]
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object"
          },
          "basis": {
            "type": "object"
          },
          "root_cause": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "upstream",
                  "theme_token",
                  "wrapper",
                  "consumer",
                  "mixed",
                  "unresolved"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "class",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "agent_procedure": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spread": {
            "type": "object"
          },
          "activation_blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "rule_id",
          "version",
          "type",
          "status",
          "finding_refs",
          "component_ids",
          "requirement_refs",
          "owner_role",
          "scope",
          "basis",
          "root_cause",
          "instruction",
          "agent_procedure",
          "preconditions",
          "acceptance",
          "spread",
          "activation_blockers"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "audit_id",
    "rules"
  ],
  "additionalProperties": false
}
