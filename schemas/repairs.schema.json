{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/repairs.schema.json",
  "title": "Repairs",
  "description": "REPAIRS.json: repair proposals. A proposal is never evidence of resolution (blueprint 23).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repair_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "task_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "impacted_locations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimal_change": {
            "type": "string",
            "minLength": 1
          },
          "structural_alternative": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "expected_effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_to_collect": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "applied",
              "rejected"
            ]
          }
        },
        "required": [
          "repair_id",
          "finding_refs",
          "task_refs",
          "authority_constraints",
          "impacted_locations",
          "minimal_change",
          "structural_alternative",
          "reasoning",
          "expected_effects",
          "risks",
          "owner_decisions",
          "acceptance_tests",
          "evidence_to_collect",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "repairs"
  ],
  "additionalProperties": false
}
