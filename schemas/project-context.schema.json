{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/project-context.schema.json",
  "title": "Project context",
  "description": "PROJECT-CONTEXT.json: evidence-backed project identity (blueprint 34.1).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "discovery_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "blocked"
      ]
    },
    "identity": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "owner_role"
        ],
        "additionalProperties": false
      }
    },
    "discovery_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "discovery_status",
    "identity",
    "evidence_refs",
    "unresolved_questions",
    "discovery_fingerprint"
  ],
  "additionalProperties": false
}
