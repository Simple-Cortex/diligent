{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/signal.schema.json",
  "title": "Signal",
  "description": "One line of SIGNALS.jsonl. A signal is an advisory practice reading, not a check result: it never enters RESULTS.jsonl, APPLICABILITY.json or the gate, and it is never normative.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "signal_id": { "type": "string", "minLength": 1 },
    "signal_key": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "enum": ["content", "craft", "form_flow", "lab_performance"] },
    "instance_id": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "enum": ["lead", "within_practice", "informational", "not_tested"] },
    "value": { "description": "The measured value; any JSON, null when not tested." },
    "unit": { "type": ["string", "null"] },
    "observed": { "type": "string" },
    "threshold": {
      "type": ["object", "null"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      },
      "required": ["rule", "source", "confidence"],
      "additionalProperties": false
    },
    "label": { "type": "string", "enum": ["lab", "field", "static"] },
    "normative": { "type": "boolean", "const": false },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "executed_at": { "type": "string", "format": "date-time" },
    "engine_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "extensions": { "type": "object", "description": "Namespaced vendor or local fields." }
  },
  "required": [
    "schema_version", "signal_id", "signal_key", "family", "instance_id", "state", "value", "unit",
    "observed", "threshold", "label", "normative", "evidence_refs", "limitations", "executed_at",
    "engine_version", "run_id", "extensions"
  ],
  "additionalProperties": false
}
