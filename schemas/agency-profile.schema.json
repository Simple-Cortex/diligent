{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/agency-profile.schema.json",
  "title": "Agency profile",
  "description": "AGENCY-PROFILE.json: government relationships and selected overlays.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "draft",
        "confirmed"
      ]
    },
    "government_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "level",
          "name",
          "relationship"
        ],
        "additionalProperties": false
      }
    },
    "selected_overlays": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "status",
    "government_level",
    "relationships",
    "selected_overlays"
  ],
  "additionalProperties": false
}
