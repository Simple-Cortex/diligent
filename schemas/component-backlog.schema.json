{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/component-backlog.schema.json",
  "title": "Component backlog",
  "description": "COMPONENT-BACKLOG.json: root causes and repair sequence (blueprint 32).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "backlog_id": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "affected_instances": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "failed"
            ]
          },
          "finding_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "backlog_id",
          "root_cause",
          "owner_role",
          "affected_instances",
          "sequence",
          "verification_status",
          "finding_refs"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "audit_id",
    "items"
  ],
  "additionalProperties": false
}
