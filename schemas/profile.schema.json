{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/profile.schema.json",
  "title": "Jurisdiction and service profile",
  "description": "Selects rule packs and states the claim boundary for a jurisdiction.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "research"
      ]
    },
    "selected_packs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "corroboration": {
      "type": "object",
      "description": "Optional corroboration of the deterministic checks by a third-party engine. Off by default; a corroborator never decides a result, and a disagreement is a review item.",
      "properties": {
        "browser": {
          "type": "array",
          "description": "Corroborators to run inside the browser worker. Empty or absent means none.",
          "items": {
            "type": "string",
            "enum": ["axe-core"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "title",
    "jurisdiction",
    "status",
    "selected_packs",
    "required_facts",
    "claim_boundary"
  ],
  "additionalProperties": false
}
