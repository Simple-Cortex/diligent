{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/service-brief.schema.json",
  "title": "Service brief",
  "description": "SERVICE-BRIEF.json: blueprint 18.1 fields with provenance.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "brief_status": {
      "type": "string",
      "enum": [
        "skeleton",
        "draft",
        "owner_confirmed"
      ]
    },
    "service_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "enum": [
              "owner_confirmed",
              "research_supported",
              "operational_data",
              "inferred"
            ]
          }
        },
        "required": [
          "task_id",
          "description",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "critical_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failure_consequences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "success_measures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "enum": [
              "owner_confirmed",
              "research_supported",
              "operational_data",
              "inferred"
            ]
          }
        },
        "required": [
          "text",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "audit_id",
    "run_id",
    "brief_status",
    "service_id",
    "service_name",
    "owner",
    "subject",
    "audiences",
    "jobs",
    "critical_questions",
    "journeys",
    "failure_consequences",
    "constraints",
    "contexts",
    "evidence",
    "success_measures",
    "non_goals",
    "assumptions"
  ],
  "additionalProperties": false
}
