{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/check-result.schema.json",
  "title": "Check result",
  "description": "One line of RESULTS.jsonl (blueprint 19.3).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "check_version": {
      "type": "string",
      "minLength": 1
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "applicability_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs_review",
        "not_tested",
        "blocked",
        "error"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected": {},
    "observed": {},
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "stale": {
      "type": "boolean",
      "description": "true when the supporting evidence is past its freshness window."
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "check_id",
    "check_version",
    "obligation_id",
    "instance_id",
    "applicability_ref",
    "status",
    "evidence_refs",
    "expected",
    "observed",
    "limitations",
    "executed_at",
    "engine_version",
    "supersedes_result_id"
  ],
  "additionalProperties": false
}
