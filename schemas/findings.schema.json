{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/findings.schema.json",
  "title": "Findings",
  "description": "FINDINGS.json: deduplicated failures and leads (blueprint 10.2 and 19.3).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "findings"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "mandatory_failure",
            "possible_failure",
            "evidence_gap",
            "ux_barrier",
            "recommendation"
          ]
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "task_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affected_instances": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "certainty_basis": {
          "type": "string",
          "minLength": 1
        },
        "review_state": {
          "type": "string",
          "enum": [
            "unreviewed",
            "in_review",
            "reviewed",
            "disputed"
          ]
        },
        "repair_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "open",
                "triaged",
                "repair_proposed",
                "change_applied",
                "retest_pending",
                "verified_resolved",
                "accepted_risk",
                "exception_recorded",
                "disputed"
              ]
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "triaged",
                      "repair_proposed",
                      "change_applied",
                      "retest_pending",
                      "verified_resolved",
                      "accepted_risk",
                      "exception_recorded",
                      "disputed"
                    ]
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "state",
                  "at",
                  "evidence_refs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "state",
            "history"
          ],
          "additionalProperties": false
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "finding_id",
        "fingerprint",
        "rule_id",
        "obligation_id",
        "category",
        "authority_refs",
        "task_refs",
        "locations",
        "affected_instances",
        "severity",
        "certainty_basis",
        "review_state",
        "repair_refs",
        "owner_role",
        "lifecycle",
        "observation",
        "impact",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  }
}
