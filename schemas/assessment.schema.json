{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Simple-Cortex/diligent/schemas/assessment.schema.json",
  "title": "Assessment",
  "description": "ASSESSMENT.json: deterministic regulatory status and coverage (blueprint 24.1). Not a certification.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{6}$"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "type": "string",
      "enum": [
        "fail",
        "incomplete",
        "pass_for_declared_scope",
        "not_applicable"
      ]
    },
    "has_incomplete_work": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "properties": {
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_applicability": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "required_instances": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "selected",
        "applicable",
        "not_applicable",
        "unresolved_applicability",
        "pending",
        "required_instances",
        "executed",
        "reviewed",
        "unsupported"
      ],
      "additionalProperties": false
    },
    "denominators": {
      "type": "object",
      "properties": {
        "applicable": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "not_applicable": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved_applicability": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pending": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "executed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unsupported": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "applicable",
        "not_applicable",
        "unresolved_applicability",
        "pending",
        "executed",
        "reviewed",
        "unsupported"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "result_id": {
            "type": "string",
            "minLength": 1
          },
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "check_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "result_id",
          "obligation_id",
          "instance_id",
          "check_id"
        ],
        "additionalProperties": false
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exception_id": {
            "type": "string",
            "minLength": 1
          },
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "unverified"
            ]
          },
          "changes_result": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "exception_id",
          "obligation_id",
          "status",
          "changes_result"
        ],
        "additionalProperties": false
      }
    },
    "ux_findings_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_disposition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "release_policy_id": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "release_policy_id",
            "owner",
            "status",
            "rationale"
          ],
          "additionalProperties": false
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced vendor or local fields. Unknown top-level fields are rejected; put them here."
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "computed_at",
    "overall",
    "has_incomplete_work",
    "counts",
    "denominators",
    "unresolved",
    "failures",
    "exceptions",
    "ux_findings_ref",
    "release_disposition",
    "limitations",
    "claim_boundary"
  ],
  "additionalProperties": false
}
